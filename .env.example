# Local development secrets only. Never commit a populated .env file.

READWISE_API_TOKEN=
YOUTUBE_API_KEY=
MEDIASTACK_API_KEY=
ROSTI_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=20000
OPENAI_API_KEY=
# Backward-compatible alias; prefer OPENAI_API_KEY for new setups.
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-5-nano
SUMMARY_TIMEOUT_MS=120000
SUMMARY_MAX_PER_RUN=20
SUMMARY_CONCURRENCY=3
SUMMARY_RETRIES=2
APP_TIMEZONE=Europe/London

# Hosted/local authentication
# `public` allows any valid email to receive a one-time link for the shared demo.
# `allowlist` restricts access to AUTH_APPROVED_EMAIL.
AUTH_ACCESS_MODE=allowlist
AUTH_APPROVED_EMAIL=
AUTH_BASE_URL=http://localhost:3000
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

INGESTION_WINDOW_HOURS=12
MAX_CONTENT_CHARACTERS=40000
RANKING_CONFIG_VERSION=local-v1
RUBRIC_VERSION=local-v1
PROMPT_VERSION=local-v1
